# =====================================================================
# Pairing-admin 환경변수 전체 목록 (23개)
#
# 이 파일을 .env 로 복사해서 값을 채운다. (.env 는 .gitignore 에 있다)
#   cp .env.example .env
#
# 주의: 스프링 부트는 .env 파일을 스스로 읽지 않는다. 아래 중 하나로 주입한다.
#   - Docker      : docker run --env-file .env ...
#   - IntelliJ    : Run/Debug Configurations > Environment variables (또는 EnvFile 플러그인)
#   - 쉘(bash)    : set -a; source .env; set +a; ./gradlew bootRun
#   - EC2/systemd : /etc/systemd/system/pairing-admin.service 의 EnvironmentFile=
#
# [필수] = 배포 시 반드시 주입. [권장] = 배포 시 기본값을 바꿔야 함. 나머지는 기본값으로 둬도 된다.
# =====================================================================


# ---------------------------------------------------------------------
# 1. 서버
# ---------------------------------------------------------------------

# 관리자 서버 포트. 백엔드(8080)와 겹치지 않게 8081을 쓴다.
SERVER_PORT=8081


# ---------------------------------------------------------------------
# 2. 데이터베이스  ★ 백엔드(Pairing-backend)와 반드시 같은 값 ★
#    값이 어긋나면 두 서버가 서로 다른 DB를 보게 된다.
# ---------------------------------------------------------------------

# [필수] JDBC URL. RDS 엔드포인트를 넣는다.
DB_URL=jdbc:postgresql://localhost:5432/pairing

# [필수]
DB_USERNAME=pairing

# [필수]
DB_PASSWORD=pairing

# 커넥션 풀 크기. 같은 RDS를 백엔드와 나눠 쓰므로 작게 잡는다.
DB_POOL_SIZE=5

# admin_user 테이블 자동 생성 여부.
#   always : 기동할 때 db/schema-admin.sql 을 실행해 테이블이 없으면 만든다 (기본)
#   never  : 실행하지 않는다. DB 계정에 CREATE 권한을 주기 싫을 때 쓴다.
#            이때는 db/init/05-create-admin-user-table.sql 을 사람이 먼저 실행해야 한다.
SQL_INIT_MODE=always


# ---------------------------------------------------------------------
# 3. S3  ★ 백엔드와 반드시 같은 값 ★
# ---------------------------------------------------------------------

# [필수] 버킷명. 비우면 기동은 되지만 파일 업로드가 동작하지 않는다.
S3_BUCKET=

# 응답 URL 루트. 비우면 https://{bucket}.s3.{region}.amazonaws.com 으로 조합한다.
# CloudFront를 쓸 때만 해당 도메인을 넣는다.
S3_CDN_URL=

# object key prefix. 백엔드와 다르면 백엔드가 올린 파일을 못 찾는다.
#   로컬: local / 개발: dev / 운영: prod  (백엔드가 쓰는 값 그대로)
S3_KEY_PREFIX=

# 리전
AWS_REGION=ap-northeast-2

# AWS 자격증명.
# 비워두면 EC2 인스턴스 IAM 역할을 쓴다. 배포 환경에서는 비워두는 편이 안전하다.
# (키를 환경변수로 심으면 유출 경로가 늘고 교체를 사람이 해야 한다)
AWS_ACCESS_KEY=
AWS_SECRET_KEY=


# ---------------------------------------------------------------------
# 4. 세션 · 보안
# ---------------------------------------------------------------------

# 세션 만료 시간(무활동 기준). 요청이 있을 때마다 갱신된다.
SESSION_TIMEOUT=30m

# [권장] HTTPS 배포에서는 반드시 true.
# SESSION_COOKIE_SAME_SITE=none 을 쓰려면 이 값이 true 여야 브라우저가 쿠키를 받는다.
SESSION_COOKIE_SECURE=false

# 관리자 프론트와 API 서버의 사이트가 다르면 none, 같으면 lax.
SESSION_COOKIE_SAME_SITE=lax

# CSRF 보호. 세션(쿠키) 인증이라 운영에서는 반드시 true.
# Swagger UI / curl 로 빠르게 테스트할 때만 false 로 내린다.
CSRF_ENABLED=true

# 비밀번호 연속 실패 시 계정 잠금 기준.
LOGIN_FAIL_MAX=5

# [필수] 관리자 프론트엔드 도메인. 쉼표로 구분한다.
# 세션 쿠키를 주고받으므로 와일드카드(*)는 쓸 수 없다.
CORS_ALLOWED_ORIGINS=http://localhost:17001,http://127.0.0.1:17001


# ---------------------------------------------------------------------
# 5. 최초 관리자 계정 부트스트랩
#    admin_user 가 비어 있을 때만 잠깐 켜고, 계정이 만들어지면 다시 끄고 재배포한다.
#    평문 비밀번호를 환경에 계속 남겨둘 이유가 없다.
#    이미 같은 아이디가 있으면 아무 것도 하지 않는다. (비밀번호 초기화 용도로는 못 쓴다)
# ---------------------------------------------------------------------

ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=


# ---------------------------------------------------------------------
# 6. 문서 · 로그
# ---------------------------------------------------------------------

# [권장] Swagger UI. 관리자 API 목록은 공격자에게 좋은 지도가 되므로 운영에서는 false.
SWAGGER_ENABLED=true

# Hibernate SQL 로그 레벨. 쿼리를 보고 싶으면 debug.
LOG_SQL_LEVEL=info
